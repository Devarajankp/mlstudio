{
  "name": "malayalam-studio",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build && node desktop/tools/make-manifest.cjs dist",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/test-engine.ts",
    "desktop:prepare": "node desktop/tools/make-fonts.cjs && esbuild desktop/tools/engine-entry.ts --bundle --platform=node --format=cjs --outfile=desktop/engine.bundle.js",
    "desktop:run": "electron desktop",
    "version": "node scripts/sync-version.cjs && git add desktop/package.json",
    "desktop:start": "cd desktop && npm install && npm start"
  },
  "dependencies": {
    "@fontsource/chilanka": "^5.3.0",
    "@fontsource/gayathri": "^5.3.0",
    "@fontsource/manjari": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-malayalam": "^5.3.0",
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/extension-character-count": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-subscript": "^3.33.1",
    "@tiptap/extension-superscript": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "docx": "^9.15.4",
    "fflate": "^0.8.3",
    "fontkit": "^3.0.0",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "regenerator-runtime": "^0.14.1",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "description": "Malayalam Studio \u2013 a Word-style Malayalam word processor for the web and Windows",
  "license": "MIT",
  "author": "Devarajan K P"
}
