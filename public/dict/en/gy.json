[["Gymkhana",[["n","കായികാഭ്യാസപ്രദർശനസ്ഥലം"],["n","കായികാഭ്യാസകളരി"]]],["Gymnasiarch",[["n","ഗുരുക്കൾ"]]],["Gymnasium",[["n","കളരി"],["n","കായിക വിനോദസ്ഥലം"],["n","കായികാഭ്യാസക്കളരി (ജിംനേഷ്യം)"],["n","കായികവിനോദസ്ഥലം"],["n","വ്യായാമസ്ഥലം"]]],["Gymnast",[["n","മല്ലൻ"],["n","കായികാഭ്യാസി"]]],["Gymnastic practices",[["n","വ്യായാമശീലം"]]],["Gymnastical",[["a","വ്യായാമവിഷയകമായ"]]],["Gymnastically",[["a","വ്യായാമവിഷയകമായി"]]],["Gymnastics",[["n","അഭ്യാസം"],["n","കായികാഭ്യാസം"],["n","വ്യായാമവിദ്യ"],["n","അടവുകൾ"],["n","വ്യായാമമുറകൾ"],["n","പയറ്റ്"]]],["Gymnophoria",[["","ആരോ തന്നെ മനോവസ്ത്രാക്ഷേപം നടത്തുന്നതായുള്ള തോന്നൽ"]]],["Gymnosperm",[["","നഗ്നബീജം"],["","അണ്‌ഡങ്ങളും വിത്തുകളും രൂപാന്തരപ്പെട്ട്‌ ഇലകളുടെ ഉപരിതലത്തിലാണ്‌ ഉണ്ടാകുന്നത്‌ എന്നത്‌ അവയുടെ സവിശേഷതയാണ്‌"],["","ഒരുകാലത്ത്‌ ഭൂമുഖത്തെ സസ്യജാലത്തിന്റെ മുഖ്യഭാഗവും ഇവയായിരുന്നു."],["","വിത്തുകൾ ഉൽപ്പാദിപ്പിക്കുന്ന സസ്യങ്ങളുടെ പ്രധാനപ്പെട്ട രണ്ടുവിഭാഗങ്ങളിൽ ഒന്ന്‌."],["","അണ്‌ഡാശയത്തിനകത്തല്ല അണ്‌ഡങ്ങൾസ്ഥിതിചെയ്യുന്നത്‌"],["","ഇന്ന്‌ ആ സ്ഥാനം ആവൃതജീവികൾ കയ്യടക്കിയിരിക്കുന്നു."]]],["Gynaecology",[["n","സ്‌ത്രീരോഗവിജ്ഞാനീയം"]]],["Gynecocracy",[["n","സ്‌ത്രീമേധാവിത്വം"]]],["Gynecologist",[["n","സ്‌ത്രീരോഗ വിജ്ഞന വിദഗ്‌ദൻ"],["n","ഗൈനക്കോളജിസ്റ്റ്‌"]]],["Gynoecium",[["n","ജനിപുടം"]]],["Gynoid",[["n","യന്ത്രസ്ത്രീ"]]],["Gyp",[["n","വേലക്കാരൻ"]]],["Gypsies",[["n","ജിപ്‌സികൾ"]]],["Gypsum",[["n","ചുണ്ണാമ്പുകല്ല്‌"],["n","ശിലാസത്ത്‌"],["n","ജിപ്‌സം"],["n","കർപ്പൂരശിലാസത്ത്‌"]]],["Gypsy",[["n","നാടോടി"],["n","ജിപ്‌സി"],["n","പോക്കിരി"],["a","സഞ്ചാരജീവിതം നയിക്കുന്ന"],["n","യായാവരൻ"]]],["Gyrate",[["v","ചുറ്റുക"],["a","ചുഴലുന്ന"],["a","ചുറ്റിത്തിരിയുന്ന"],["a","വർത്തുളമായ"],["v","ചുഴലുക"],["v","നട്ടം തിരിക്കുക"],["a","മണ്‌ഡലാകാരമായ"],["v","വളയം ചുറ്റുക"],["v","നട്ടം തിരിയുക"]]],["Gyration",[["n","പരിവർത്തനം"],["n","ഭ്രമണം"],["n","വട്ടം തിരിച്ചിൽ"]]],["Gyratory",[["a","കറങ്ങുന്ന"],["a","ഭ്രമണം ചെയ്യുന്ന"]]],["Gyve",[["v","വിലങ്ങിടുക"],["n","കയ്യാമം"],["n","കാൽവിലങ്ങ്‌"],["v","ആമം വയ്‌ക്കുക"]]]]