[["Ioc",[["n","ഇൻപുട്ട്‌ ഔട്ട്‌പുട്ട്‌ കൺട്രാളർ"],["n","ഒന്നോ അതിലധികമോ ഇൻപുട്ട്‌, ഔട്ട്‌പുട്ട്‌ ചാനലുകളെ നിയന്ത്രിക്കുന്ന ഘടകം"]]],["Iodine",[["n","അയോഡിൻ"],["n","അയഡിൻ"],["n","ഒരു ഖരമൂലകം"],["n","ഊതകം"],["n","ഖരമൂലകം"]]],["Ion",[["n","അണുവിൽ ഇലക്‌ട്രാണുകൾ കൂടുകയോ കുറയുകയോ ചെയ്യുന്നതുകൊണ്ടുണ്ടാവുന്നതും സ്ഥാനന്തരപ്രാപ്‌തിമൂലം വൈദ്യുതിയെ പരിവഹിപ്പിക്കുന്നതുമായ വൈദ്യുതാധാനമുള്ള കണം"],["n","അയൺ"],["n","ഒരു അണു"]]],["Ionise",[["v","ഉള്ളിൽ അയണുകൾ ഉത്‌പാദിപ്പിക്കുക"],["v","അയണുകളായി രൂപാന്തരപ്പെടുത്തുക"]]],["Ionize",[["v","അയണീകരിക്കൽ"]]],["Ionosphere",[["n","വായുമണ്‌ഡലത്തിന്റെ ഉപരിതലത്തിലെ അത്യയണീകൃതമായ പ്രദേശം"],["n","അയണമണ്‌ഡലം"],["n","ഒരു അന്തരീക്ഷമേഖല"]]],["Iota",[["n","ശകലം"],["n","അണു"],["n","മാത്ര"],["n","ലേശം"],["n","സ്വൽപം"],["n","കണിക"],["n","സ്വല്പം"],["n","യവന അക്ഷരമാലയിലെ ഒൻപതാം അക്ഷരം"]]]]