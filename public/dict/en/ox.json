[["Ox hydrogen",[["n","പ്രാണവായുവും ജലവായുവും കത്തിജ്ജ്വലിക്കുന്നതിനുതകുന്ന അവയുടെ യോഗം"]]],["Ox-eyed",[["a","ഉണ്ടക്കണ്ണുള്ള"]]],["Oxails",[["n","നീരാരൽ"],["","പുളിയിരൽ"]]],["Oxbow",[["n","കാളപ്പുരികത്തിന്റെ ആകൃതിയിലുള്ള നടവഴി"]]],["Oxbridge",[["n","ഉപരിവർഗ്ഗവിദ്യാഭ്യാസത്തിന്റെ മാതൃകകളായി ഗണിക്കുന്ന ഓക്‌സ്‌ഫോർഡിനെയും കേംബ്രിജിനെയും ഒരു മിച്ചു പരാമർശിക്കുന്ന പദം"],["n","ഓക്‌സ്‌ഫോർഡ്‌, കേംബ്രിഡ്‌ജ്‌ എന്നീ സർവ്വകലാശാലകൾക്കു പൊതുവേയുള്ള പേര്‌"]]],["Oxeana",[["","പീനസദ്രവം"],["","മൂക്കിൽനിന്നു ദുർഗന്ധത്തോടുകൂടിയ സ്രവം"]]],["Oxfam",[["abbr","ഓക്‌സ്‌ഫോർഡ്‌ കമ്മിറ്റി ഫോർ ഫെമൈൻ റിലീഫ്‌"]]],["Oxidation",[["n","ജാരണകാരി"]]],["Oxidator",[["n","ദീപജ്വാലയിലേയ്‌ക്കു പ്രാണവായു പ്രവഹിപ്പിക്കുന്നതിനുള്ള സൂത്രം"]]],["Oxide",[["n","ഭസ്‌മം"],["","ഓക്‌സിജനം ഏതെങ്കിലും മൂലകവും ചേർന്ന രാസസംയുക്തം"],["n","സിന്ദൂരം"],["n","ഓക്‌സിജനും മറ്റൊരു മൂലകവും ചേർന്നുണ്ടാകുന്ന സംയുക്തം"]]],["Oxidizable",[["n","ഭസ്‌മീകരത്വം"]]],["Oxidize",[["v","ഭസ്‌മമാക്കുക"],["v","ഭസ്‌മീകരിക്കുക"],["v","ഓക്‌സൈഡാക്കുക"]]],["Oxonian",[["n","ആ സർവ്വകലാശാലയിലെ വിദ്യാർത്ഥി"],["","ഓക്‌സ്‌ഫോർഡ്‌"],["a","സർവ്വകലാശാലയെ സംബന്ധിച്ച"]]],["Oxter",[["v","ആലിംഗനം ചെയ്യുക"],["v","കൈയ്‌ക്കുപിടിച്ചു സഹായിക്കുക"]]],["Oxyacetylene",[["n","ഓക്‌സിജനും അസറ്റിലിനും ഉപയോഗിച്ചുള്ള സംയുക്തം"]]],["Oxygen",[["n","പ്രാണവായു"],["n","അമ്ലജബാഷ്‌പം"],["n","അമ്ലജനകം"],["n","ജീവവായു"],["n","ഓക്‌സിജൻ"],["n","ഓക്സിജൻ"]]],["Oxygen mask",[["n","ഉയർന്നത തലങ്ങളിൽ വൈമാനികർക്കും പർവ്വാരോഹകർക്കും ഓക്‌സിജൻ നൽകുന്ന മുഖം മൂടിപോലുള്ള ഒരു ഉപകരണം"],["n","ഓക്‌സിജൻ നൽകുന്ന മുഖാവരണം"]]],["Oxygen tent",[["n","ശ്വസിക്കാൻ പ്രയാസമുള്ള രോഗിയുടെ ചുറ്റുമായി ഉയർത്തുന്നതും അകത്ത്‌ ഓക്‌സിജൻ പ്രവാഹം യഥേഷ്‌ടം നിയന്ത്രിക്കാവുന്നതുമായ കൂടാരം പോലുള്ള ഒരുപകരണം"],["n","ഓക്‌സിജൻ പ്രവാഹം യഥേഷ്‌ടം നിയന്ത്രിക്കാനുള്ള കൂടാരം പോലുള്ള ഒരുപകരണം"]]],["Oxygenate",[["n","അമ്ലജബാഷ്‌പീകരണം"],["v","ഓക്‌സിജൻ കലർത്തുക"]]],["Oxygenation",[["n","ഓക്‌സിജീകരണം"],["n","ജാരണം"],["n","അമലിതം കലർത്തൽ"]]],["Oxygenize",[["v","അമലിതം കലർത്തുക"]]],["Oxylophyte",[["n","അമ്ലമയമുള്ള മണ്ണിൽ വളരുന്ന ചെടി"]]],["Oxymoron",[["n","വിരുദ്ധോക്തി"],["n","വിരോധാക്തി"]]]]