[["Yiddish",[["n","പഴയ ജർമ്മൻ ഭാഷയും മറ്റും കലർന്നുണ്ടായ ജൂതഭാഷ"]]],["Yield",[["v","ലഭിക്കുക"],["v","വഴങ്ങുക"],["v","നൽകുക"],["v","കീഴടങ്ങുക"],["v","ഉപേക്ഷിക്കുക"],["v","ത്യജിക്കുക"],["n","വരുമാനം"],["n","ലാഭം"],["v","വിളയുക"],["v","വരവുണ്ടാക്കുക"],["v","കായ്‌ക്കുക"],["v","ഉണ്ടാകുക"],["n","വിറ്റുവരവ്‌"],["n","വഴങ്ങിക്കൊടുക്കുക"],["n","കായ്ക്കുക"],["n","ആദായമുണ്ടാകുക"]]],["Yield the point",[["v","വാദത്തിൽ സമ്മതിച്ചുകൊടുക്കുക"]]],["Yielding",[["a","വഴങ്ങുന്നത്"],["a","വഴക്കമുള്ള"],["a","ലഭ്യമാവുന്ന"],["a","എങ്ങനെയും തിരിക്കാവുന്ന"]]],["Yielding fruits",[["a","ഫലപ്രദമായ"]]],["Yielding rich harvest",[["a","സമൃദ്ധമായ വിള നൽകുന്ന"]]],["Yields",[["n","വിളകൾ"]]],["Yin",[["n","വിധിയെ സ്വാധീനിക്കുന്നതായി പറയപ്പെടുന്ന പ്രപഞ്ചത്തിലെ സ്‌ത്രീ തത്ത്വം"]]]]