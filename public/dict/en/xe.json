[["Xed out",[["v","ലിസ്റ്റിൽ നിന്നും പേരു വെട്ടിക്കളയുക"]]],["Xenobombulate",[["v","വിഷലിപ്തമാകുക"]]],["Xenogamy",[["n","അന്യകേസരപരിഗ്രഹണം"]]],["Xenogenesis",[["","ഭിന്നഗുണപ്രജോൽപത്തി"]]],["Xenon",[["n","ഒരു ഗന്ധരഹിത വാതക മൂലകം"],["n","നിറമോ ഗന്ധമോ ഇല്ലാത്ത ഒരു വാതക മൂലകം"]]],["Xenophilia",[["n","വിദേശികളോടുള്ള ആദരം"]]],["Xenophobe",[["n","അപരിചിതരേയും വിദേശികളേയും വെറുക്കുന്നവൻ"]]],["Xenophobia",[["n","ഭയം"],["n","അപരിചിതരോടുള്ള ഒരുതരം വിദ്വേഷം"],["n","വിദേശീയവിദ്വേഷം"],["n","പരദേശീസ്‌പർദ്ധ"]]],["Xenophyophores",[["n","സമുദ്രങ്ങളിൽ കണ്ടു വരുന്ന ഭീമമായ ഏകകോശ ജീവികൾ"]]],["Xeroderma",[["","ഒരു ചർമ്മത്തിലവസാനിക്കുന്ന ത്വക്ക്‌ വരൾച്ച"]]],["Xerography",[["n","ധാരാളം കോപ്പികളെടുക്കുവാനുള്ള ഒരു പ്രക്രിയ"]]],["Xerophilous",[["n","ഏറ്റവും വരണ്ട കാലാവസ്ഥയിലും ജീവിക്കാൻ കഴിവുള്ള സസ്യം"]]],["Xerophyte",[["n","കള്ളിച്ചെടി"],["n","മരുസസ്യം"],["n","വെള്ളം തീരെകുറവായതോ മിക്കവാറും വരണ്ടതോആയസ്ഥലത്ത്‌ വളരാൻകഴിവുള്ള സസ്യം"]]],["Xerophytes",[["n","വെള്ളമില്ലാത്ത ഭൂമിയിൽ വളരുന്ന ചെടി"]]],["Xerox",[["n","ഫോട്ടോകോപ്പി"],["n","ഡോക്യുമെന്റുകളുടെ ധാരാളം കോപ്പികളെടുക്കാനുള്ള മാർഗ്ഗം"],["n","ഫോട്ടോക്കോപ്പിയന്ത്രം നിർമ്മിക്കുന്ന ഒരു കമ്പനിയുടെ പേര്‌"],["","ഫോട്ടാസ്റ്റാറ്റ്‌ എന്നതിനു പകരമായി ഈ വാക്ക്‌ ഇപ്പോൾ പ്രചാരത്തിലുണ്ട്‌"],["n","ഊഷരപ്രതലത്തിൽ ചിത്രപ്പതിപ്പുകളെടുക്കുന്ന ഒരു പ്രക്രിയ"],["a","പതിപ്പുകളെടുക്കുന്ന"],["v","പതിപ്പുകളെടുക്കുക"],["v","പ്രതികളുണ്ടാക്കുക"]]]]