ി"]]],["Euro-election",[["n","യൂറോപ്യൻ ജനപ്രതിനിധിസഭാ തെരഞ്ഞെടുപ്പ്‌"]]],["Eurocentric",[["a","യൂറോപ്യൻ നയങ്ങളെ പിന്തുടരുന്ന"],["a","യൂറോപ്പ് കേന്ദ്രീകൃതമായ"]]],["Eurocheque",[["n","യൂറോപ്‌ ബാങ്കിലെ ചെക്ക്‌"],["n","വിവിധ യൂറോപ്യൻ രാജ്യങ്ങളിൽ ഉപയോഗിക്കാവുന്ന ബാങ്ക്‌ ചെക്ക്‌"]]],["Eurocrat",[["n","യൂറോപ്യൻ സഖ്യരാഷ്‌ട്രങ്ങളിലെ ഒരു ഉദ്യോഗസ്ഥമേധാവി"]]],["Europe",[["n","യൂറോപ്പ്‌"],["n","ഉത്തരാർദ്ധ ഗോളത്തിൽ ആഫ്രിക്കയ്‌ക്കു വടക്കും ഏഷ്യയ്‌ക്കു പടിഞ്ഞാറുമായി സ്ഥിതി ചെയ്യുന്ന ഭൂഖണ്‌ഡം"]]],["European",[["n","വെള്ളക്കാരൻ"],["n","യൂറോപ്യൻ"],["n","പാശ്ചാത്യൻ"],["a","യൂറോപ്പിനെ സംബന്ധിച്ച"],["a","യൂറോപ്പുകാരനായ"],["n","യൂറോപ്പുകാരൻ"]]],["Eurus",[["n","തെക്കുകിഴക്കൻകാറ്റ്‌"]]],["Eustacy",[["n","ആഗോള സമുദ്രജലനിരപ്പിലെ ഉയർച്ചയും താഴ്ചയും"]]],["Euthanasia",[["","യൂത്തനേസിയ"],["n","അനായാസമരണം"],["n","വേദനയില്ലാക്കൊല"],["n","കാരുണ്യവധം"],["n","ദയാവധം"],["n","അനായാസമൃത്യു"]]],["Eutrophication",[["n","അമിതപോഷണം"]]]]