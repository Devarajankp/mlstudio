[["Nyaya philosophy",[["n","ന്യായമതം"],["n","ന്യായാഭിപ്രായം"],["n","ന്യായശാസ്‌ത്രം"]]],["Nylon",[["n","നേർത്ത തന്തുക്കളോ രോമങ്ങളോ പാളികളോ ആക്കാവുന്ന ഒരു രാസപദാർത്ഥം"],["n","ഇതുകൊണ്ടുണ്ടാക്കിയ കൃത്രിമപ്പട്ട്‌"],["n","നൈലോൺ"],["n","നേർത്ത തന്തുക്കളോ പാളികളോ ആക്കാവുന്ന പദാർത്ഥം"],["n","അതുകൊണ്ടുള്ള വസ്‌ത്രം"]]],["Nymph",[["n","ജലദേവത"],["n","രൂപവതി"],["n","ജലകന്യക"],["n","സൗന്ദര്യവതിയായ കന്യക"],["n","സ്വർഗ്ഗീയ സുന്ദരി"],["n","അപ്‌സര സ്‌ത്രീ"],["n","സുന്ദരിയായ കന്യക"],["n","അപ്സരസ്ത്രീ"]]],["Nymphomania",[["","സ്‌ത്രീകളുടെ സുരതോൻമാദം"]]],["Nymphomaniac",[["n","അതികാമാർത്തയായ സ്‌ത്രീ"],["n","ലൈംഗിക ദാഹി"],["n","കാമ പീഡിത"],["n","പതിവിൽ കവിഞ്ഞ്‌ ലൈംഗിക മോഹമുള്ള സ്‌ത്രീ"]]],["Nyphomaniac",[["n","കാമഭ്രാന്തൻ"]]]]