[["Oedema",[["n","നീര്"]]],["Oedipus",[["n","കടങ്കഥാ പരിഹാരകൻ"]]],["Oedipus complex",[["","പുത്രനു മാതാവിനോടു തോന്നുന്ന സ്‌നേഹവും തൻമുലം പിതാവിനോട്‌ അബോധപൂർവ്വം തോന്നുന്ന അസൂയാവൈരങ്ങളും"]]],["Oem",[["n","ഒറിജിനൽ എക്യുപ്‌മെന്റ്‌ മാനുഫാക്‌ച്ചർ"]]],["Oenophile",[["n","വീഞ്ഞ് ആസ്വദിക്കുന്നയാൾ"]]],["Oer",[["","മുകളിൽ"]]],["Oersted",[["n","സെന്റീമീറ്റർ ഗ്രാം സെക്കൻഡ്‌ പദ്ധതിയിൽ കാന്തക്ഷേത്ര ശഗക്തിയുടെ ഏകകം"]]],["Oesophagus",[["n","അന്നനാളം"],["n","അന്നവാഹിനി"]]],["Oestrogen",[["n","സ്ത്രീയുടെ ലൈംഗിക വളർച്ചയെ നിയന്ത്രിക്കുന്ന ഹോർമൊൺ"]]],["Oeuvre",[["n","സാഹിത്യകാരൻ ചിത്രകാരൻ തുടങ്ങിയവരുടെ കലാസൃഷ്ടികൾ"]]]]