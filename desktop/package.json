{
  "name": "malayalam-studio-desktop",
  "version": "1.2.3",
  "productName": "Malayalam Studio",
  "description": "Malayalam Studio for Windows – editor + system-wide Malayalam typing",
  "main": "main.js",
  "author": "Devarajan K P",
  "license": "MIT",
  "dependencies": { "koffi": "^2.16.4" },
  "devDependencies": { "electron": "33.4.11", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "in.mlstudio.app",
    "productName": "Malayalam Studio",
    "copyright": "Copyright © 2026 Devarajan K P – MIT licence",
    "directories": { "output": "release" },
    "asar": false,
    "files": ["main.js", "preload.js", "winapi.js", "engine.bundle.js", "defaults.json", "icon*.png", "ui/**", "web/**", "fonts/**", "package.json", "node_modules/**"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "artifactName": "Malayalam-Studio-Setup-${version}.exe" },
    "portable": { "artifactName": "Malayalam-Studio-Portable-${version}.exe" },
    "publish": null
  }
}
